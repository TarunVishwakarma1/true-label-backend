DATABASE_URL=postgres://postgres:postgres@localhost:5432/truelabel
REDIS_URL=redis://localhost:6379
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_ENV=development
MAX_DB_CONNECTIONS=10
MAX_REDIS_CONNECTIONS=10
RUST_LOG=info

# JWT audience for Sign in with Apple identity-token verification —
# your app's bundle id.
APPLE_BUNDLE_ID=com.tarun.truelable

# How many proxies sit in front of this process, and therefore how much of
# X-Forwarded-For was written by them rather than by the caller. MUST stay 0
# until a reverse proxy is actually in front — see docs/deployment.mdx.
TRUSTED_PROXY_HOPS=0

# Skips the "TRUSTED_PROXY_HOPS is set but this process is listening on a
# public interface" boot check. Only meaningful in a container: a k8s
# ClusterIP Service (or equivalent) is what actually stops direct access
# there, not SERVER_HOST — see k8s/base/backend/configmap.yaml. Leave unset
# for local dev and for the bare-metal/droplet case, where the check is
# still real.
# TRUST_CONTAINER_NETWORK=true

# Comma-separated browser origins allowed to call the API. Native clients
# send no Origin, so this only needs the dashboard (web/apps/dashboard) —
# the only browser-based client that exists so far.
ALLOWED_ORIGINS=http://localhost:3002

# Optional: overrides the default 12 req/min outbound budget to Open Food
# Facts (services/openfoodfacts.rs). Leave unset to use the default.
# OFF_RATE_LIMIT_PER_MINUTE=12

# The dashboard's "publish as GitHub issue" button. A PAT with Issues:write
# on GITHUB_REPO (fine-grained) or the classic `repo` scope. Leave both
# unset and that one endpoint fails with a clear error; everything else
# works without it.
# GITHUB_TOKEN=
# GITHUB_REPO=TarunVishwakarma1/true-lable

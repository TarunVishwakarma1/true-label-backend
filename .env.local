# ==========================================
# For Local Development (running on your Mac)
# ==========================================
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
LOCAL_REDIS_URL=redis://localhost:6379

# ==========================================
# For Kubernetes Backend (running inside cluster)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@db-service:5432/postgres
DB_HOST=db-service
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres

REDIS_URL=redis://redis-service:6379
REDIS_HOST=redis-service
REDIS_PORT=6379
